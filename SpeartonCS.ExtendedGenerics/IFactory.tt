namespace SpeartonCS.ExtendedGenerics;

/// <summary>
/// Factory function for <typeparamref name="TResult"/> without parameters
/// </summary>
public interface IFactory<out TResult>
	where TResult : allows ref struct
{
	public abstract static TResult Factory();
}
<#
	for (int i = 1; i < 16; i++)
	{
#>

/// <summary>
/// Factory function for <typeparamref name="TResult"/> with parameters: <#for (int j = 1; j <= i; j++) {#><typeparamref name="T<#=j#>"/><#if (j != i){#>, <#}}#>

/// </summary>
public interface IFactory<out TResult<#for (int j = 1; j <= i; j++) {#>, in T<#=j#><#}#>>
	where TResult : allows ref struct
<#for (int j = 1; j <= i; j++) {#>
	where T<#=j#> : allows ref struct
<#}#>{
	public abstract static TResult Factory(<#for (int j = 1; j <= i; j++) {#>T<#=j#> t<#=j#><#if (j != i){#>, <#}}#>);
}
<#
	}
#>