<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SpeartonCS.ExtendedGenerics</Title>
    <Authors>SpeartonCS</Authors>
    <Description>Generic constaints and features that are not yet represented in .NET 10</Description>
    <PackageTags>dotnet;net;10;net10;generics;safe;constraint;extended;ext;feature</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/Spearton-CS/SpeartonCS.ExtendedGenerics</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Spearton-CS/SpeartonCS.ExtendedGenerics</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
