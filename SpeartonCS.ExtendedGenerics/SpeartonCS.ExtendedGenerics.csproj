  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IFactory - Copy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Numerics\_Operators\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="IDeconstructible.cs">
      <DependentUpon>IDeconstructible.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </None>
    <None Include="IFactory.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IFactory.tt</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="IDeconstructible.tt">
      <LastGenOutput>IDeconstructible.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="IFactory.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>IFactory.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
