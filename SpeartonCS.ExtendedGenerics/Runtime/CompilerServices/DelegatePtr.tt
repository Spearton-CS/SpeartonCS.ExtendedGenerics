    "MemberFunction",
    "StdCall",
    "SuppressGCTransition",
    "Swift",
    "ThisCall",

    "CdeclSuppressGCTransition",
    "FastCallSuppressGCTransition",
    "MemberFunctionSuppressGCTransition",
    "StdCallSuppressGCTransition",
    "SwiftSuppressGCTransition",
    "ThisCallSuppressGCTransition",
