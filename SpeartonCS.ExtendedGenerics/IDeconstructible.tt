#>

/// <summary>
/// Deconstruct function with parameters: <#for (int j = 1; j <= i; j++) {#><typeparamref name="T<#=j#>"/><#if (j != i){#>, <#}}#>

/// </summary>
public interface IDeconstructible<<#for (int j = 1; j <= i; j++) {#>T<#=j#><#if (j != i){#>, <#}}#>>
<#for (int j = 1; j <= i; j++) {#>
	where T<#=j#> : allows ref struct
<#}#>{
	public void Deconstruct(<#for (int j = 1; j <= i; j++) {#>out T<#=j#> t<#=j#><#if (j != i){#>, <#}}#>);
}
<#
	}
#>